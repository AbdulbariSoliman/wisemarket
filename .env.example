# ============================================================
# WISEMARKET — ENVIRONMENT VARIABLES
# Copy to `.env` and fill in. `.env` is git-ignored.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-anon-or-service-role-key>

# ── Admin API (required for /admin/* endpoints) ──────────────
ADMIN_API_KEY=<long-random-string>

# ── LLM / Groq (required for /agent endpoints) ───────────────
GROQ_API_KEY=<your-groq-api-key>

# Optional model overrides (defaults shown):
LLM_INTENT_MODEL=groq/llama-3.1-8b-instant
LLM_REFINER_MODEL=groq/llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=groq/llama-3.1-8b-instant

# If you switch models to OpenAI (e.g. LLM_INTENT_MODEL=gpt-4o-mini),
# LiteLLM will need this instead of GROQ_API_KEY:
# OPENAI_API_KEY=<your-openai-api-key>

# ── CORS (optional) ──────────────────────────────────────────
# Frontend origins allowed to call the API (comma-separated).
# Defaults to the local Vite dev/preview servers.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Error monitoring (optional) ──────────────────────────────
SENTRY_DSN=

# ── Path override (optional) ─────────────────────────────────
# WISEMARKET_ROOT=/absolute/path/to/wisemarket

# ── Frontend (frontend/wisemarket) ───────────────────────────
VITE_API_URL=http://localhost:8000
