# =============================================================================
# WiseMarket environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Use the anon/public key for the app; use the service_role key only for
# trusted server-side ingestion (never ship it to the frontend).
SUPABASE_KEY=<your-supabase-anon-or-service-role-key>

# --- Admin API (required for /admin/* endpoints) -----------------------------
# Sent by clients as the `X-Admin-Key` header. Choose a long random string.
ADMIN_API_KEY=<long-random-string>

# --- LLM / Groq (required for the agent + chat endpoints) --------------------
# LiteLLM routes to Groq by default (see backend/services/llm_client.py).
GROQ_API_KEY=<your-groq-api-key>
# Optional model overrides (defaults shown):
LLM_INTENT_MODEL=groq/llama-3.1-8b-instant
LLM_REFINER_MODEL=groq/llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=groq/llama-3.1-8b-instant
# If you switch models to OpenAI (e.g. LLM_INTENT_MODEL=gpt-4o-mini), also set:
# OPENAI_API_KEY=<your-openai-api-key>

# --- Error monitoring (optional) ---------------------------------------------
# Leave empty to disable Sentry.
SENTRY_DSN=

# --- Frontend (frontend/wisemarket) ------------------------------------------
# Consumed by Vite at build time. Point it at the backend API base URL.
VITE_API_URL=http://localhost:8000
