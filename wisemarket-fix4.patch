+_ALCOHOL_FREE_NAME = re.compile(
+    r"alkoholfrei|sans alcool|alcohol[- ]free|non[- ]alcoholic|analcolic|senza alcol|"
+    r"\b0[.,]0\b|ginger|ingwer|root beer")
